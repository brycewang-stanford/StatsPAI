  {
   "name": "stteffects/ipw-heavy-censoring",
   "estimator": "stteffects",
   "call": "stteffects(method=\"ipw\")",
   "design": "censoring rate 0.15: long failure times are almost always censored",
   "n": 2000,
   "B": 1000,
   "truth": 0.6807004539857352,
   "n_failed": 0,
   "first_error": "",
   "seconds": 14.7,
   "coverage": 0.953,
   "se_over_sd": 0.3814,
   "bias_over_sd": 0.0502,
   "mean_estimate": 0.707175332425473,
   "sd_estimate": 0.5270249601775434,
   "mean_se": 0.20101673365077966,
   "median_se_over_mad": 0.854,
   "median_bias_over_mad": 0.005,
   "coverage_wald_z": 0.953,
   "prefix": {
    "draws": 20,
    "ok": 20,
    "sum_estimate": 13.329086675900351,
    "sum_se": 3.0702836592773197
   },
   "flagged": true,
   "statspai_version": "1.43.1",
   "screen": {
    "B": 400,
    "coverage": 0.9625,
    "se_over_sd": 0.2733,
    "bias_over_sd": 0.0709
   },
   "mechanism": "Design breaks the overlap that censoring weights need. With censoring rate 0.15 the second moment of T / G(T) does not exist for units with x1 > 1.2: long failure times are almost always censored and the rare uncensored one carries a huge weight. The estimator is heavy-tailed, so SE/SD does not settle (0.66, 0.27 and 0.38 in three runs) while coverage stays at 92% to 96%. At rate 0.04 (row stteffects/ipw) SE/SD is 0.98. sp.stteffects now records the censoring weights in model_info and its notes describe the condition."
  },
