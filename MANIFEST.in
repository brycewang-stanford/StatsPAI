# Include essential files for PyPI distribution
include LICENSE
include THIRD_PARTY_NOTICES.md
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include CITATION.cff
include pyproject.toml

# Include package source code
recursive-include src *.py
recursive-include src *.pyi
recursive-include src py.typed
recursive-include src/statspai/schemas *.json
include src/statspai/_parity_index.json
# Verified master bibliography, shipped so sp.bibtex() resolves on a wheel install
# (kept byte-identical to the root paper.bib by tools/bib_subset.py packaged --check).
include src/statspai/paper.bib

# Include tests and fixtures so source distributions can run the shipped
# parity/snapshot suites without regenerating reference artifacts.
recursive-include tests *
# ...but not the gitignored local outputs that `recursive-include` would
# otherwise sweep up from a working tree: the reproduction scratch area of
# verify_reproduce*.py, the Track C shared inputs written by
# tests/perf/_data.py (38 MB, regenerated byte for byte from seeds), and the
# NHEFS extracts regenerated on demand (their redistribution is left to the
# upstream source, hence the .gitignore).
prune tests/r_parity/results/_repro_check
prune tests/perf/data
recursive-exclude tests/orig_parity/data *_nhefs_*.csv

# Exclude internal documentation and development files
exclude PROJECT_SUMMARY.md
exclude FINAL_PROJECT_STATUS.md
exclude RELEASE_CHECKLIST.md
exclude build_and_release.sh
exclude Makefile
exclude *.sh

# Exclude development directories (not needed for users)
exclude docs/
recursive-exclude docs *
exclude examples/
recursive-exclude examples *
exclude .github/
recursive-exclude .github *

# Exclude build and cache files
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .DS_Store
recursive-exclude tests *.log
exclude .git*
exclude .pytest_cache
exclude .mypy_cache
exclude htmlcov
exclude .coverage
exclude *.egg-info
exclude build/
exclude dist/
exclude .venv/
exclude venv/
exclude .pre-commit-config.yaml
